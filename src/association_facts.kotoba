;; The CBI source catalog, as Kotoba.
;;
;; GENERATED by scripts/gen-kotoba-port.cljs from data/datascript-tx.edn,
;; which src/association/facts.cljc holds as data. Both are the same
;; catalog; this one reaches the Kotoba oracle, wasm and both native ISAs,
;; which the .cljc cannot. Do not hand-edit -- run the generator, and
;; `--check` will tell you if someone did.
;;
;; `:topic` is a SET in the source. A set has no order and `topic` is
;; indexed by position, so the generator uses the order the data file
;; writes. `by-topic-id` answers by name and is unaffected.
;;
;; Parity: test/association_facts_kotoba_parity_test.clj compares every
;; field of every entry against the .cljc, so this file cannot drift from
;; the data without the suite saying so.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "cbi"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 12 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 12)) false))

(defn entry-field-0 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "cbi.charter-petition-1965-04-15")
    (string=? f "title") (option-some-of [:option :string] "Federation of British Industries petitioned Her Majesty in Council for a new Charter under the style and title of 'The Confederation of British Industry'; the Privy Council Office notice is dated 15 April 1965 and was published in The London Gazette issue 43627, page 3777")
    (string=? f "association") (option-some-of [:option :string] "cbi")
    (string=? f "isic") (option-some-of [:option :string] "9411")
    (string=? f "country") (option-some-of [:option :string] "GBR")
    (string=? f "kind") (option-some-of [:option :string] "governance-program")
    (string=? f "url") (option-some-of [:option :string] "https://www.thegazette.co.uk/London/issue/43627/page/3777/data.pdf")
    (string=? f "url-provenance") (option-some-of [:option :string] "uk-public-record")
    (string=? f "source-article") (option-some-of [:option :string] "The London Gazette, Issue 43627 (16 April 1965), Page 3777 -- Privy Council Office notice")
    (string=? f "source-quote") (option-some-of [:option :string] "Notice is hereby given that a Petition of the Federation of British Industries, praying for the grant of a new Charter under the style and title of \" The Confederation of British Industry\", has been presented to Her Majesty in Council, and, Her Majesty having referred the said Petition to a Committee of the Lords of the Council, Notice is further given that all Petitions for or against such grant should be delivered to the Privy Council Office on or before the llth day of May next. 15th April 1965.")
    (string=? f "established-date") (option-some-of [:option :string] "1965-04-15")
    (string=? f "date-precision") (option-some-of [:option :string] "day")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
    :else (option-none-of [:option :string])))

