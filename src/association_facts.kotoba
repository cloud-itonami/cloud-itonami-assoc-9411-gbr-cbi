(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (entry-field-0 f)
      (= i 1) (entry-field-1 f)
      (= i 2) (entry-field-2 f)
      (= i 3) (entry-field-3 f)
      (= i 4) (entry-field-4 f)
      (= i 5) (entry-field-5 f)
      (= i 6) (entry-field-6 f)
      (= i 7) (entry-field-7 f)
      (= i 8) (entry-field-8 f)
      (= i 9) (entry-field-9 f)
      (= i 10) (entry-field-10 f)
      (= i 11) (entry-field-11 f)
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (cond
      (= i 0) 2
      (= i 1) 2
      (= i 2) 2
      (= i 3) 2
      (= i 4) 2
      (= i 5) 1
      (= i 6) 1
      (= i 7) 1
      (= i 8) 1
      (= i 9) 1
      (= i 10) 1
      (= i 11) 2
      :else 0)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (cond
        (= t 0) (option-some-of [:option :string] "governance")
        (= t 1) (option-some-of [:option :string] "public-record")
        :else (option-none-of [:option :string]))
      (= i 1) (cond
        (= t 0) (option-some-of [:option :string] "governance")
        (= t 1) (option-some-of [:option :string] "registration")
        :else (option-none-of [:option :string]))
      (= i 2) (cond
        (= t 0) (option-some-of [:option :string] "european-representation")
        (= t 1) (option-some-of [:option :string] "membership")
        :else (option-none-of [:option :string]))
      (= i 3) (cond
        (= t 0) (option-some-of [:option :string] "contact")
        (= t 1) (option-some-of [:option :string] "membership")
        :else (option-none-of [:option :string]))
      (= i 4) (cond
        (= t 0) (option-some-of [:option :string] "european-representation")
        (= t 1) (option-some-of [:option :string] "contact")
        :else (option-none-of [:option :string]))
      (= i 5) (cond
        (= t 0) (option-some-of [:option :string] "transparency")
        :else (option-none-of [:option :string]))
      (= i 6) (cond
        (= t 0) (option-some-of [:option :string] "transparency")
        :else (option-none-of [:option :string]))
      (= i 7) (cond
        (= t 0) (option-some-of [:option :string] "transparency")
        :else (option-none-of [:option :string]))
      (= i 8) (cond
        (= t 0) (option-some-of [:option :string] "transparency")
        :else (option-none-of [:option :string]))
      (= i 9) (cond
        (= t 0) (option-some-of [:option :string] "governance")
        :else (option-none-of [:option :string]))
      (= i 10) (cond
        (= t 0) (option-some-of [:option :string] "european-representation")
        :else (option-none-of [:option :string]))
      (= i 11) (cond
        (= t 0) (option-some-of [:option :string] "governance")
        (= t 1) (option-some-of [:option :string] "contact")
        :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "contact") 3
      (string=? candidate "european-representation") 3
      (string=? candidate "governance") 4
      (string=? candidate "membership") 2
      (string=? candidate "public-record") 1
      (string=? candidate "registration") 1
      (string=? candidate "transparency") 4
      :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (cond
      (string=? candidate "contact") (cond
        (= i 0) (entry-field a 3 "id")
        (= i 1) (entry-field a 4 "id")
        (= i 2) (entry-field a 11 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "european-representation") (cond
        (= i 0) (entry-field a 2 "id")
        (= i 1) (entry-field a 4 "id")
        (= i 2) (entry-field a 10 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "governance") (cond
        (= i 0) (entry-field a 0 "id")
        (= i 1) (entry-field a 1 "id")
        (= i 2) (entry-field a 9 "id")
        (= i 3) (entry-field a 11 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "membership") (cond
        (= i 0) (entry-field a 2 "id")
        (= i 1) (entry-field a 3 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "public-record") (cond
        (= i 0) (entry-field a 0 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "registration") (cond
        (= i 0) (entry-field a 1 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "transparency") (cond
        (= i 0) (entry-field a 5 "id")
        (= i 1) (entry-field a 6 "id")
        (= i 2) (entry-field a 7 "id")
        (= i 3) (entry-field a 8 "id")
        :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] 
      "cloud-itonami-assoc-9411-gbr-cbi Wave 0 (ADR-2607141700): 12 CBI entries, each citing a source with the page and the verbatim span it rests on. None of them is CBI speaking about itself -- cbi.org.uk answers 403. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
